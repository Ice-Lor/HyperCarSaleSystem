<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>HyperCarSaleSystem</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- 1. ENCODING FILTER (UTF-8 Toàn Diện) -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>filter.EncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 2. CSRF FILTER (Bảo Mật Form POST) -->
    <filter>
        <filter-name>CSRFFilter</filter-name>
        <filter-class>filter.CSRFFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CSRFFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 3. AUTH FILTER (Bắt Buộc Đăng Nhập) -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/checkout</url-pattern>
        <url-pattern>/order-history</url-pattern>
        <url-pattern>/order-success</url-pattern>
        <url-pattern>/test-drive</url-pattern>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/review</url-pattern>
    </filter-mapping>

    <!-- 4. ADMIN FILTER (Phân Quyền Ban Quản Trị) -->
    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>filter.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- SERVLET MAPPINGS -->
    <!-- Auth -->
    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>controller.auth.LoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterController</servlet-name>
        <servlet-class>controller.auth.RegisterController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterController</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutController</servlet-name>
        <servlet-class>controller.auth.LogoutController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutController</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileController</servlet-name>
        <servlet-class>controller.auth.ProfileController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileController</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- Client -->
    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>controller.client.HomeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CarListController</servlet-name>
        <servlet-class>controller.client.CarListController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CarListController</servlet-name>
        <url-pattern>/cars</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CarDetailController</servlet-name>
        <servlet-class>controller.client.CarDetailController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CarDetailController</servlet-name>
        <url-pattern>/car-detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CartController</servlet-name>
        <servlet-class>controller.client.CartController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartController</servlet-name>
        <url-pattern>/cart</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CheckoutController</servlet-name>
        <servlet-class>controller.client.CheckoutController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckoutController</servlet-name>
        <url-pattern>/checkout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OrderSuccessController</servlet-name>
        <servlet-class>controller.client.OrderSuccessController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderSuccessController</servlet-name>
        <url-pattern>/order-success</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OrderHistoryController</servlet-name>
        <servlet-class>controller.client.OrderHistoryController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderHistoryController</servlet-name>
        <url-pattern>/order-history</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TestDriveController</servlet-name>
        <servlet-class>controller.client.TestDriveController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestDriveController</servlet-name>
        <url-pattern>/test-drive</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReviewController</servlet-name>
        <servlet-class>controller.client.ReviewController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewController</servlet-name>
        <url-pattern>/review</url-pattern>
    </servlet-mapping>

    <!-- Admin -->
    <servlet>
        <servlet-name>AdminDashboardController</servlet-name>
        <servlet-class>controller.admin.AdminDashboardController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardController</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminCarController</servlet-name>
        <servlet-class>controller.admin.AdminCarController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminCarController</servlet-name>
        <url-pattern>/admin/cars</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminBrandController</servlet-name>
        <servlet-class>controller.admin.AdminBrandController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminBrandController</servlet-name>
        <url-pattern>/admin/brands</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminOrderController</servlet-name>
        <servlet-class>controller.admin.AdminOrderController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminOrderController</servlet-name>
        <url-pattern>/admin/orders</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminBookingController</servlet-name>
        <servlet-class>controller.admin.AdminBookingController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminBookingController</servlet-name>
        <url-pattern>/admin/bookings</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUserController</servlet-name>
        <servlet-class>controller.admin.AdminUserController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserController</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ExportReportController</servlet-name>
        <servlet-class>controller.admin.ExportReportController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExportReportController</servlet-name>
        <url-pattern>/admin/export-orders</url-pattern>
    </servlet-mapping>

    <!-- REST/AJAX APIs -->
    <servlet>
        <servlet-name>ApiLiveSearchController</servlet-name>
        <servlet-class>controller.api.ApiLiveSearchController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiLiveSearchController</servlet-name>
        <url-pattern>/api/search</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiCheckCouponController</servlet-name>
        <servlet-class>controller.api.ApiCheckCouponController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiCheckCouponController</servlet-name>
        <url-pattern>/api/coupon</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiCartController</servlet-name>
        <servlet-class>controller.api.ApiCartController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiCartController</servlet-name>
        <url-pattern>/api/cart</url-pattern>
    </servlet-mapping>

    <!-- Session Timeout -->
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>

</web-app>
